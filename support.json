        "3.4.6": { "postgresql_minimum_major": 15, "postgresql_maximum_major": 17 },
        "3.5.7": { "postgresql_minimum_major": 15, "postgresql_maximum_major": 18 },
        "3.6.4": { "postgresql_minimum_major": 15, "postgresql_maximum_major": 18 }
