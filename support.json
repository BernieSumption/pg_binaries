{
  "schema_version": 1,
  "postgresql": {
    "minimum_major": 15,
    "stable_release_cutoff": "2025-09-25",
    "release_source": "https://www.postgresql.org/ftp/source/"
  },
  "os_support": {
    "macos": { "minimum_version": "11.0" },
    "windows": { "minimum_version": "10.0.10240.0" },
